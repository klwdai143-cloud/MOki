local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("CrystalRemotes")
local Action, Notice = remotes:WaitForChild("Action"), remotes:WaitForChild("Notice")
local gui = script.Parent
gui.ResetOnSpawn = false

local function make(className, properties, parent)
    local object = Instance.new(className)
    for key, value in pairs(properties) do object[key] = value end
    object.Parent = parent
    return object
end
local function corner(parent, radius)
    make("UICorner", {CornerRadius=UDim.new(0,radius)}, parent)
end
local function stroke(parent, color, thickness)
    make("UIStroke", {Color=color, Thickness=thickness, Transparency=.12}, parent)
end

local panel = make("Frame", {
    Name="CrystalHUD", Size=UDim2.fromOffset(300,208), Position=UDim2.new(0,14,0.5,-104),
    BackgroundColor3=Color3.fromRGB(16,22,39), BackgroundTransparency=.06
}, gui)
corner(panel,16); stroke(panel,Color3.fromRGB(91,220,255),2)
make("TextLabel", {
    Size=UDim2.new(1,-20,0,38), Position=UDim2.fromOffset(10,7), BackgroundTransparency=1,
    Text="✦  STEAL A CRYSTAL", TextColor3=Color3.fromRGB(235,249,255),
    TextScaled=true, Font=Enum.Font.GothamBlack
}, panel)
local cashLabel = make("TextLabel", {
    Name="CashLabel", Size=UDim2.new(1,-22,0,34), Position=UDim2.fromOffset(11,48),
    BackgroundColor3=Color3.fromRGB(31,43,65), Text="CASH  100",
    TextColor3=Color3.fromRGB(255,224,105), TextScaled=true, Font=Enum.Font.GothamBold
}, panel)
corner(cashLabel,9)
local rebirthLabel = make("TextLabel", {
    Size=UDim2.new(1,-22,0,24), Position=UDim2.fromOffset(11,85),
    BackgroundTransparency=1, Text="REBIRTHS  0", TextColor3=Color3.fromRGB(170,215,255),
    TextScaled=true, Font=Enum.Font.GothamBold
}, panel)

local function addButton(parent, text, y, command)
    local button = make("TextButton", {
        Size=UDim2.new(1,-22,0,34), Position=UDim2.fromOffset(11,y),
        BackgroundColor3=Color3.fromRGB(43,112,164), Text=text,
        TextColor3=Color3.new(1,1,1), TextScaled=true, Font=Enum.Font.GothamBold,
        AutoButtonColor=true
    }, parent)
    corner(button,9)
    button.Activated:Connect(function() Action:FireServer(command) end)
    return button
end
addButton(panel,"⚡  UPGRADE SPEED",115,"UpgradeSpeed")
addButton(panel,"✧  REBIRTH  •  5,000",154,"Rebirth")

local toast = make("TextLabel", {
    Size=UDim2.new(0,340,0,42), Position=UDim2.new(.5,-170,0,18),
    BackgroundColor3=Color3.fromRGB(18,26,43), Text="", TextColor3=Color3.new(1,1,1),
    TextScaled=true, Font=Enum.Font.GothamBold, Visible=false
}, gui)
corner(toast,10); stroke(toast,Color3.fromRGB(91,220,255),1)

if player.Name == "amin_12in2" then
    local adminButton = make("TextButton", {
        Name="OwnerAdminButton", Size=UDim2.fromOffset(132,38),
        Position=UDim2.new(1,-146,0,16), BackgroundColor3=Color3.fromRGB(105,63,177),
        Text="OWNER PANEL", TextColor3=Color3.new(1,1,1), TextScaled=true,
        Font=Enum.Font.GothamBlack
    }, gui)
    corner(adminButton,10); stroke(adminButton,Color3.fromRGB(208,174,255),1)
    local admin = make("Frame", {
        Name="OwnerAdminPanel", Size=UDim2.fromOffset(235,206),
        Position=UDim2.new(1,-249,0,62), BackgroundColor3=Color3.fromRGB(25,20,43),
        Visible=false
    }, gui)
    corner(admin,13); stroke(admin,Color3.fromRGB(190,140,255),2)
    make("TextLabel", {
        Size=UDim2.new(1,-12,0,34), Position=UDim2.fromOffset(6,5),
        BackgroundTransparency=1, Text="OWNER • amin_12in2",
        TextColor3=Color3.new(1,1,1), TextScaled=true, Font=Enum.Font.GothamBlack
    }, admin)
    local function adminAction(label,y,arg)
        local b=make("TextButton",{
            Size=UDim2.new(1,-16,0,34),Position=UDim2.fromOffset(8,y),
            BackgroundColor3=Color3.fromRGB(91,62,150),Text=label,
            TextColor3=Color3.new(1,1,1),TextScaled=true,Font=Enum.Font.GothamBold
        },admin)
        corner(b,8); b.Activated:Connect(function() Action:FireServer("Admin",arg) end)
    end
    adminAction("Give 100,000 Cash",43,"GiveCash")
    adminAction("Set Cash to 1,000,000",82,"SetCash")
    adminAction("Server Announcement",121,"Broadcast")
    adminAction("Clear Spawned Crystals",160,"ClearCrystals")
    adminButton.Activated:Connect(function() admin.Visible=not admin.Visible end)
end

Notice.OnClientEvent:Connect(function(message)
    toast.Text=tostring(message); toast.Visible=true
    task.delay(2.7,function() if toast.Parent then toast.Visible=false end end)
end)

task.spawn(function()
    while gui.Parent do
        local stats=player:FindFirstChild("leaderstats")
        if stats then
            local cash=stats:FindFirstChild("Cash")
            local rebirths=stats:FindFirstChild("Rebirths")
            if cash then cashLabel.Text="CASH  "..cash.Value end
            if rebirths then rebirthLabel.Text="REBIRTHS  "..rebirths.Value end
        end
        task.wait(.2)
    end
end)
