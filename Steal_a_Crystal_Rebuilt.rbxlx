class="Part"><Properties><string name="Name">CornerPylon_1_1</string><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><bool name="CanTouch">true</bool><bool name="CanQuery">true</bool><CoordinateFrame name="CFrame"><X>23.0000</X><Y>5.0000</Y><Z>308.0000</Z><R00>1.000000</R00><R01>0</R01><R02>0.000000</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>-0.000000</R20><R21>0</R21><R22>1.000000</R22></CoordinateFrame><Vector3 name="Size"><X>3.0000</X><Y>8.0000</Y><Z>3.0000</Z></Vector3><int name="BrickColor">1001</int><token name="Material">256</token><token name="Shape">1</token><float name="Transparency">0</float><float name="Reflectance">0</float><bool name="CastShadow">true</bool><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties></Item></Item></Item><Item class="Folder"><Properties><string name="Name">LiveCrystals</string></Properties></Item></Item><Item class="ServerScriptService"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script"><Properties><string name="Name">CrystalGameServer</string><ProtectedString name="Source">
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local ADMIN_USERNAMES = { ["amin_12in2"] = true }
local ZONES = {
    {name="Verdant Grove", z=95, value=5, color=Color3.fromRGB(75,255,135), unlock=0},
    {name="Glacier Hollow", z=25, value=20, color=Color3.fromRGB(100,220,255), unlock=250},
    {name="Ember Canyon", z=-55, value=75, color=Color3.fromRGB(255,105,55), unlock=1500},
    {name="Thunder Highlands", z=-135, value=250, color=Color3.fromRGB(175,125,255), unlock=8000},
    {name="Astral Sanctum", z=-215, value=1000, color=Color3.fromRGB(255,235,100), unlock=35000},
}
local remotes = ReplicatedStorage:FindFirstChild("CrystalRemotes") or Instance.new("Folder")
remotes.Name = "CrystalRemotes"; remotes.Parent = ReplicatedStorage
local Action = remotes:FindFirstChild("Action") or Instance.new("RemoteEvent")
Action.Name = "Action"; Action.Parent = remotes
local Notice = remotes:FindFirstChild("Notice") or Instance.new("RemoteEvent")
Notice.Name = "Notice"; Notice.Parent = remotes

local basesFolder = Workspace:WaitForChild("PlayerBases")
local liveFolder = Workspace:WaitForChild("LiveCrystals")
local claimed = {}

local function notify(player, message)
    Notice:FireClient(player, message)
end

local function makeStats(player)
    local stats = Instance.new("Folder"); stats.Name = "leaderstats"; stats.Parent = player
    local cash = Instance.new("IntValue"); cash.Name = "Cash"; cash.Value = 100; cash.Parent = stats
    local rebirths = Instance.new("IntValue"); rebirths.Name = "Rebirths"; rebirths.Value = 0; rebirths.Parent = stats
    local inventory = Instance.new("Folder"); inventory.Name = "CrystalInventory"; inventory.Parent = player
    player:SetAttribute("SpeedLevel", 0)
    player:SetAttribute("IncomeMultiplier", 1)
end

local function assignBase(player)
    for _, base in ipairs(basesFolder:GetChildren()) do
        if not claimed[base] then
            claimed[base] = player
            player:SetAttribute("BaseName", base.Name)
            local sign = base:FindFirstChild("OwnerSign", true)
            if sign then
                local gui = Instance.new("BillboardGui")
                gui.Name = "OwnerBillboard"; gui.Size = UDim2.fromOffset(180, 42)
                gui.StudsOffset = Vector3.new(0, 5, 0); gui.AlwaysOnTop = true
                gui.Parent = sign
                local label = Instance.new("TextLabel")
                label.Size = UDim2.fromScale(1,1); label.BackgroundTransparency = 1
                label.Text = player.DisplayName .. "'s Base"
                label.TextColor3 = Color3.new(1,1,1); label.TextStrokeTransparency = .2
                label.TextScaled = true; label.Font = Enum.Font.GothamBold; label.Parent = gui
            end
            return base
        end
    end
    notify(player, "All bases are occupied. You can still explore.")
end

local function crystalSpawn(zone, zoneIndex)
    local model = Instance.new("Model")
    model.Name = "Crystal_" .. zoneIndex .. "_" .. tostring(math.floor(os.clock()*1000))
    local core = Instance.new("Part")
    core.Name = "Core"; core.Shape = Enum.PartType.Ball
    core.Size = Vector3.new(3.2,3.2,3.2); core.Material = Enum.Material.Neon
    core.Color = zone.color; core.Anchored = true; core.CanCollide = false
    core.Position = Vector3.new(math.random(-58,58), 5, zone.z + math.random(-18,18))
    core.Parent = model
    local light = Instance.new("PointLight")
    light.Color = zone.color; light.Range = 13; light.Brightness = 1.5; light.Parent = core
    local prompt = Instance.new("ProximityPrompt")
    prompt.ActionText = "Collect"; prompt.ObjectText = zone.name .. " Crystal"
    prompt.HoldDuration = .25; prompt.MaxActivationDistance = 11
    prompt.RequiresLineOfSight = false; prompt.Parent = core
    model:SetAttribute("CashValue", zone.value); model.Parent = liveFolder
    prompt.Triggered:Connect(function(player)
        if not model.Parent then return end
        local stats = player:FindFirstChild("leaderstats")
        local inventory = player:FindFirstChild("CrystalInventory")
        if not stats or not inventory then return end
        local cash = stats:FindFirstChild("Cash")
        if not cash then return end
        cash.Value += zone.value * (player:GetAttribute("IncomeMultiplier") or 1)
        local item = Instance.new("IntValue")
        item.Name = zone.name .. " Crystal"; item.Value = 1; item.Parent = inventory
        notify(player, "+" .. zone.value .. " Cash • " .. zone.name)
        model:Destroy()
    end)
    task.delay(25, function()
        if model.Parent then model:Destroy() end
    end)
end

Players.PlayerAdded:Connect(function(player)
    makeStats(player)
    assignBase(player)
    player.CharacterAdded:Connect(function(character)
        task.wait(.35)
        local baseName = player:GetAttribute("BaseName")
        local base = baseName and basesFolder:FindFirstChild(baseName)
        local floor = base and base:FindFirstChild("Foundation", true)
        if floor then character:PivotTo(floor.CFrame + Vector3.new(0,5,0)) end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid.WalkSpeed = 16 + (player:GetAttribute("SpeedLevel") or 0)*2 end
    end)
end)

Players.PlayerRemoving:Connect(function(player)
    for base, owner in pairs(claimed) do
        if owner == player then
            claimed[base] = nil
            local sign = base:FindFirstChild("OwnerBillboard", true)
            if sign then sign:Destroy() end
        end
    end
end)

task.spawn(function()
    while true do
        for index, zone in ipairs(ZONES) do
            if #liveFolder:GetChildren() &lt; 40 then crystalSpawn(zone, index) end
        end
        task.wait(3.5)
    end
end)

task.spawn(function()
    while true do
        for _, player in ipairs(Players:GetPlayers()) do
            local stats = player:FindFirstChild("leaderstats")
            local inventory = player:FindFirstChild("CrystalInventory")
            if stats and inventory then
                local amount = #inventory:GetChildren()
                local multiplier = player:GetAttribute("IncomeMultiplier") or 1
                stats.Cash.Value += amount * multiplier
            end
        end
        task.wait(12)
    end
end)

Action.OnServerEvent:Connect(function(player, command, argument)
    local stats = player:FindFirstChild("leaderstats")
    if not stats then return end
    if command == "UpgradeSpeed" then
        local level = player:GetAttribute("SpeedLevel") or 0
        local cost = 100 * (level + 1)
        if stats.Cash.Value &lt; cost then notify(player, "Not enough Cash. Need " .. cost); return end
        stats.Cash.Value -= cost
        level += 1; player:SetAttribute("SpeedLevel", level)
        if player.Character then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid then humanoid.WalkSpeed = 16 + level*2 end
        end
        notify(player, "Speed upgraded to level " .. level)
    elseif command == "Rebirth" then
        if stats.Cash.Value &lt; 5000 then notify(player, "You need 5,000 Cash to Rebirth."); return end
        stats.Cash.Value = 100
        stats.Rebirths.Value += 1
        player:SetAttribute("IncomeMultiplier", 1 + stats.Rebirths.Value * .25)
        player:SetAttribute("SpeedLevel", 0)
        notify(player, "Rebirth complete! Income multiplier increased.")
    elseif command == "Admin" then
        if not ADMIN_USERNAMES[player.Name] then return end
        if argument == "GiveCash" then
            stats.Cash.Value += 100000
        elseif argument == "Broadcast" then
            for _, target in ipairs(Players:GetPlayers()) do
                notify(target, "[OWNER] " .. player.DisplayName .. " sent an announcement.")
            end
        elseif argument == "ClearCrystals" then
            liveFolder:ClearAllChildren()
        elseif argument == "SetCash" then
            stats.Cash.Value = 1000000
        end
        notify(player, "Admin command completed.")
    end
end)
